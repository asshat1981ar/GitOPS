{
  "name": "gitops-review-inbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.ts",
    "start": "node server/start.ts",
    "prepack": "npm run build && node scripts/release-notices.mjs",
    "verify:release": "node --test test/release-runtime.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bootstrap-icons": "^1.13.2"
  },
  "files": [
    "dist/index.html",
    "dist/assets/",
    "server/*.ts",
    "src/review.ts",
    "dist/licenses/"
  ]
}
